# Password for the login page. If empty, the server makes one on first start and writes it here.
PHOSPHOR_PASSWORD=
# Folder Claude works in (new tabs start here). Default: your home folder.
PHOSPHOR_CWD=
# Port on localhost. Default: 7337
PHOSPHOR_PORT=
# DOCS: the folder documents live in. Default: Documents in your home folder (~/Documents),
# made when the first document is saved.
PHOSPHOR_DOCS_DIR=
# DOCS: folders it shows but never changes, separated by ; (: on Linux). Default: none.
PHOSPHOR_DOCS_READONLY=
# TODAY panel: Google Calendar's secret iCal address (read-only); more than one: separate with a comma or space. See docs/CALENDAR.md.
PHOSPHOR_CALENDAR_ICS=
# IDEAS panel: the "do this later" file (format in shared/ideas.ts). Default: parked.md in PHOSPHOR_CWD. No file = no panel.
PHOSPHOR_IDEAS_FILE=
# IDEAS weekly: folders of dated work notes (YYYY-MM-DD in the file name), separated by : (; on Windows). Each Friday
# morning one Sonnet call reads the past 7 days and adds up to 5 ideas under ## Suggested. Unset = never runs.
PHOSPHOR_IDEAS_NOTES=
# off = no weekly suggestions even with notes set.
PHOSPHOR_IDEAS_WEEKLY=
# Gemini pictures (docs/IMAGE-MODEL.md, "Gemini pictures"): on when Antigravity CLI is installed (PHOSPHOR_AGY, default
# ~/.local/bin/agy) and signed in. Picker entries as "Label=model,Label=model", or off.
PHOSPHOR_GEMINI_IMAGE=
# STATION > Unraid (docs/STATION.md): your Unraid server's health on the STATION screen, read-only. Needs Unraid 7.2 or
# newer, or any 7.x with the Unraid Connect plugin. URL: the server's address, like http://192.168.1.10. KEY: an Unraid
# API key made with the VIEWER role (Settings > Management Access > API Keys). Either one empty = not connected.
# Restart the server after changing them. The key never goes to the page, a log, data/ or a chat.
PHOSPHOR_UNRAID_URL=
PHOSPHOR_UNRAID_KEY=
# 1 only if the address is https with a certificate this PC does not trust (Unraid's own).
PHOSPHOR_UNRAID_SELF_SIGNED=
