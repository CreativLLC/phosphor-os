#!/usr/bin/env bash
# Phosphor-OS DICTATE in any app: press Ctrl+Space, talk, press it again; the words go in where the cursor is.
# A take is phosphor-dictate-live.mjs (next to this file), run by the app's Node in the background: it streams the
# default microphone to the Phosphor-OS server's speech engine (the same one the app uses, on this PC), writes
# what it hears so far for the bar's overlay, and puts the text into the focused program when you stop
# (phosphor-dictate-paste.mjs; CLEAN UP in ~/.config/phosphor-os/dictate.json tidies it first).
#
#   phosphor-dictate toggle   start, or stop and put the words in (Ctrl+Space outside the app; a click on the clock's mic)
#   phosphor-dictate cancel   stop, nothing goes in
#   phosphor-dictate reset    forget a take left over from before a crash or logout (runs at login)
#
# State for the bar (Dictation.qml, the overlay in BarWidget.qml): ~/.local/state/phosphor-os/dictate. Line 1:
# idle | recording | transcribing; then the text heard so far (cleared when the take ends).
# Login: a cookie jar in $XDG_RUNTIME_DIR (memory, gone at logout), made by logging in with the password in the
# app's .env (never printed, never on a command line).
set -uo pipefail

state_home=${XDG_STATE_HOME:-}
[[ $state_home == /* ]] || state_home="$HOME/.local/state"
STATE="$state_home/phosphor-os/dictate"
RUN="${XDG_RUNTIME_DIR:-/tmp}/phosphor-dictate"
PID="$RUN/take.pid"
JAR="$RUN/cookie"
LIVE="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/phosphor-dictate-live.mjs"
MAX_SECONDS=300 # the server takes up to 5 minutes in one piece

mkdir -p "${STATE%/*}" && mkdir -p -m 700 "$RUN" || exit 1
# One at a time: a press while a take is still starting waits for it, then stops it like any second press. Two at once
# both started a take, and the one the PID file lost recorded unseen for 5 minutes, then pasted.
exec 9>"$RUN/lock"
flock -w 20 9 || exit 0

set_state() { printf '%s\n' "$1" >"$STATE"; }
state() { head -n1 "$STATE" 2>/dev/null | grep . || echo idle; }
say() { notify-send -a DICTATE -u "${2:-normal}" "DICTATE" "$1" 2>/dev/null || echo "phosphor-dictate: $1" >&2; }
taking() { [[ -s $PID ]] && kill -0 "$(cat "$PID")" 2>/dev/null; }

# The app's folder: PHOSPHOR_OS_DIR, else where its server unit runs.
app_dir() {
  local d=${PHOSPHOR_OS_DIR:-}
  [[ -n $d ]] || d=$(systemctl --user show phosphor-os-server -p WorkingDirectory --value 2>/dev/null)
  [[ -n $d && -f $d/.env ]] && printf '%s' "$d"
}
env_value() { # KEY from the app's .env, quotes taken off
  sed -n -E "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$2" | tail -n1 | sed -E 's/^"(.*)"$/\1/; s/^'\''(.*)'\''$/\1/'
}
# The Node the server runs on (PHOSPHOR_NODE, else the unit's, else the first on PATH).
node_bin() {
  local n=${PHOSPHOR_NODE:-}
  [[ -x $n ]] || n=$(systemctl --user show phosphor-os-server -p ExecStart --value 2>/dev/null | sed -n -E 's/.*path=([^ ;]+).*/\1/p')
  [[ -x $n ]] || n=$(command -v node)
  [[ -n $n ]] && printf '%s' "$n"
}

DIR=$(app_dir) || DIR=
PORT=7337
if [[ -n $DIR ]]; then # the server's port: PHOSPHOR_PORT in its .env (RETRO_PORT before the rename)
  for key in PHOSPHOR_PORT RETRO_PORT PORT; do
    p=$(env_value "$key" "$DIR/.env")
    [[ $p =~ ^[0-9]+$ ]] && { PORT=$p; break; }
  done
fi
URL="http://127.0.0.1:$PORT"

login() {
  [[ -n $DIR ]] || return 1
  local pw
  pw=$(env_value PHOSPHOR_PASSWORD "$DIR/.env")
  [[ -n $pw ]] || pw=$(env_value RETRO_PASSWORD "$DIR/.env")
  [[ -n $pw ]] || return 1
  (umask 077; printf '%s' "$pw" | curl -s -m 5 -o /dev/null -c "$JAR" --data-urlencode 'password@-' "$URL/login") || return 3
  grep -q rcs "$JAR" 2>/dev/null
}

# Wake the speech engine, logging in first when needed: 0 ok, 2 can't log in, 3 server down.
warm() {
  local code r
  if [[ ! -s $JAR ]]; then
    login
    r=$?
    ((r == 0)) || return $((r == 3 ? 3 : 2))
  fi
  for _ in 1 2; do
    code=$(curl -s -m 5 -o /dev/null -w '%{http_code}' -b "$JAR" -X POST "$URL/api/voice/warm") || return 3 # a hung server is down
    [[ $code == 401 ]] || return 0
    login
    r=$?
    ((r == 0)) || return $((r == 3 ? 3 : 2))
  done
  return 2
}

start() {
  local node
  node=$(node_bin) || { say "Can't find Node to run DICTATE." critical; return; }
  set_state recording # the mic shows at once
  warm
  case $? in
    2) set_state idle; say "Can't log in to Phosphor-OS. Is the app's server running?" critical; return ;;
    3) set_state idle; say "Phosphor-OS is not answering on port $PORT." critical; return ;;
  esac
  rm -f "$PID"
  DICT_URL=$URL DICT_APP=$DIR DICT_JAR=$JAR DICT_STATE=$STATE DICT_MAX=$MAX_SECONDS DICT_PID=$PID \
    setsid -f "$node" "$LIVE" </dev/null >/dev/null 2>&1 9>&- # the take must not hold the lock
  # The take writes its PID once it listens for the stop signal: a stop sent sooner would be lost (and Node opens its
  # debugger on a SIGUSR1 it does not handle).
  for _ in $(seq 60); do
    taking && return
    [[ $(state) == idle ]] && return # the take gave up (it said why)
    sleep 0.05
  done
  set_state idle
  say "DICTATE did not start." critical
}

case ${1:-toggle} in
  toggle)
    # Stop and put the words in, unless the take is already doing that.
    if taking; then [[ $(state) == transcribing ]] || kill -USR1 "$(cat "$PID")"; else start; fi
    ;;
  cancel)
    taking && kill -TERM "$(cat "$PID")"
    set_state idle
    ;;
  reset)
    taking && kill -TERM "$(cat "$PID")"
    rm -f "$PID"
    set_state idle
    ;;
  *)
    echo "usage: phosphor-dictate toggle|cancel|reset" >&2
    exit 2
    ;;
esac
