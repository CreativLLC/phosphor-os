# Phosphor-OS OS theme. Generated by os/tools/build-themes.mjs from palettes.mjs.

# Main background, empty for terminal default
theme[main_bg]="#0b0700"
theme[main_fg]="#ffb000"
theme[title]="#ffd68a"
theme[hi_fg]="#ffd68a"
theme[selected_bg]="#4a3300"
theme[selected_fg]="#ffd68a"
theme[inactive_fg]="#8a6206"
theme[graph_text]="#ffc54a"
theme[meter_bg]="#150e03"
theme[proc_misc]="#ffb000"

# Box outlines and dividers
theme[cpu_box]="#b07c08"
theme[mem_box]="#b07c08"
theme[net_box]="#b07c08"
theme[proc_box]="#b07c08"
theme[div_line]="#8a6206"

# Meters and graphs
theme[temp_start]="#b07c08"
theme[temp_mid]="#ffb000"
theme[temp_end]="#ff5f1f"
theme[cpu_start]="#b07c08"
theme[cpu_mid]="#ffb000"
theme[cpu_end]="#ffd68a"
theme[free_start]="#b07c08"
theme[free_mid]="#ffb000"
theme[free_end]="#ffd68a"
theme[cached_start]="#b07c08"
theme[cached_mid]="#ffb000"
theme[cached_end]="#ffd68a"
theme[available_start]="#b07c08"
theme[available_mid]="#ffb000"
theme[available_end]="#ffd68a"
theme[used_start]="#b07c08"
theme[used_mid]="#ffb000"
theme[used_end]="#ffd68a"
theme[download_start]="#b07c08"
theme[download_mid]="#ffb000"
theme[download_end]="#ffd68a"
theme[upload_start]="#b07c08"
theme[upload_mid]="#ffb000"
theme[upload_end]="#ffd68a"
theme[process_start]="#b07c08"
theme[process_mid]="#ffb000"
theme[process_end]="#ffd68a"

# Graph shades, background to brightest
theme[gradient_color_0]="#0b0700"
theme[gradient_color_1]="#150e03"
theme[gradient_color_2]="#4a3300"
theme[gradient_color_3]="#8a6206"
theme[gradient_color_4]="#b07c08"
theme[gradient_color_5]="#ffb000"
theme[gradient_color_6]="#ffc54a"
theme[gradient_color_7]="#ffd68a"
