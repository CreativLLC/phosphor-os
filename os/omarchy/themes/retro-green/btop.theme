# Phosphor-OS OS theme. Generated by os/tools/build-themes.mjs from palettes.mjs.

# Main background, empty for terminal default
theme[main_bg]="#010a03"
theme[main_fg]="#33ff66"
theme[title]="#b6ffc9"
theme[hi_fg]="#b6ffc9"
theme[selected_bg]="#0b4a1d"
theme[selected_fg]="#b6ffc9"
theme[inactive_fg]="#1f8a3f"
theme[graph_text]="#7dff9d"
theme[meter_bg]="#04140a"
theme[proc_misc]="#33ff66"

# Box outlines and dividers
theme[cpu_box]="#23a845"
theme[mem_box]="#23a845"
theme[net_box]="#23a845"
theme[proc_box]="#23a845"
theme[div_line]="#1f8a3f"

# Meters and graphs
theme[temp_start]="#23a845"
theme[temp_mid]="#33ff66"
theme[temp_end]="#dfff4f"
theme[cpu_start]="#23a845"
theme[cpu_mid]="#33ff66"
theme[cpu_end]="#b6ffc9"
theme[free_start]="#23a845"
theme[free_mid]="#33ff66"
theme[free_end]="#b6ffc9"
theme[cached_start]="#23a845"
theme[cached_mid]="#33ff66"
theme[cached_end]="#b6ffc9"
theme[available_start]="#23a845"
theme[available_mid]="#33ff66"
theme[available_end]="#b6ffc9"
theme[used_start]="#23a845"
theme[used_mid]="#33ff66"
theme[used_end]="#b6ffc9"
theme[download_start]="#23a845"
theme[download_mid]="#33ff66"
theme[download_end]="#b6ffc9"
theme[upload_start]="#23a845"
theme[upload_mid]="#33ff66"
theme[upload_end]="#b6ffc9"
theme[process_start]="#23a845"
theme[process_mid]="#33ff66"
theme[process_end]="#b6ffc9"

# Graph shades, background to brightest
theme[gradient_color_0]="#010a03"
theme[gradient_color_1]="#04140a"
theme[gradient_color_2]="#0b4a1d"
theme[gradient_color_3]="#1f8a3f"
theme[gradient_color_4]="#23a845"
theme[gradient_color_5]="#33ff66"
theme[gradient_color_6]="#7dff9d"
theme[gradient_color_7]="#b6ffc9"
