# Phosphor-OS OS theme. Generated by os/tools/build-themes.mjs from palettes.mjs.

# Main background, empty for terminal default
theme[main_bg]="#000000"
theme[main_fg]="#ffcc99"
theme[title]="#ff9900"
theme[hi_fg]="#ffcc66"
theme[selected_bg]="#33335c"
theme[selected_fg]="#ffcc66"
theme[inactive_fg]="#7a7aa8"
theme[graph_text]="#ffddb3"
theme[meter_bg]="#1a1a2e"
theme[proc_misc]="#cc99cc"

# Box outlines and dividers
theme[cpu_box]="#ff9900"
theme[mem_box]="#cc99cc"
theme[net_box]="#9999ff"
theme[proc_box]="#ffcc66"
theme[div_line]="#333355"

# Meters and graphs
theme[temp_start]="#9999ff"
theme[temp_mid]="#ffcc66"
theme[temp_end]="#cc4444"
theme[cpu_start]="#9999ff"
theme[cpu_mid]="#cc99cc"
theme[cpu_end]="#ff9900"
theme[free_start]="#9999cc"
theme[free_mid]="#9999ff"
theme[free_end]="#99ccff"
theme[cached_start]="#cc99cc"
theme[cached_mid]="#9999cc"
theme[cached_end]="#9999ff"
theme[available_start]="#ffcc66"
theme[available_mid]="#ff9900"
theme[available_end]="#ff9900"
theme[used_start]="#ffcc99"
theme[used_mid]="#ff9900"
theme[used_end]="#cc4444"
theme[download_start]="#9999cc"
theme[download_mid]="#9999ff"
theme[download_end]="#bbbbff"
theme[upload_start]="#ffcc99"
theme[upload_mid]="#ffcc66"
theme[upload_end]="#ff9900"
theme[process_start]="#9999cc"
theme[process_mid]="#cc99cc"
theme[process_end]="#ff9900"

# Graph shades, background to brightest
theme[gradient_color_0]="#000000"
theme[gradient_color_1]="#121220"
theme[gradient_color_2]="#33335c"
theme[gradient_color_3]="#9999cc"
theme[gradient_color_4]="#cc99cc"
theme[gradient_color_5]="#ffcc99"
theme[gradient_color_6]="#ffcc66"
theme[gradient_color_7]="#ff9900"
