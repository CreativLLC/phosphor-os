  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build -c vite.saver.config.ts",
    "start": "npm run build && node scripts/serve.mjs",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
