    "test:sdkversion": "tsx tests/sdkversion.ts",
    "test:calendar": "tsx tests/calendar.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "@fontsource/vt323": "^5.3.0",
