    "@simplewebauthn/server": "^14.0.3",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-hard-break": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-underline": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "dompurify": "^3.4.16",
    "marked": "^18.1.0",
    "node-ical": "0.27.3",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
